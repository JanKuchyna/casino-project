@model LoginViewModel
@{
    ViewData["Title"] = "Přihlášení";
    var loginErrors = ViewData.ModelState[string.Empty]?.Errors;
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-4 text-center">Přihlášení</h1>

                @if (loginErrors is { Count: > 0 })
                {
                    <div class="alert alert-danger" role="alert">
                        @loginErrors[0].ErrorMessage
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="username" />
                        <label asp-for="Email"></label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" placeholder="Heslo" autocomplete="current-password" />
                        <label asp-for="Password"></label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">Přihlásit se</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
