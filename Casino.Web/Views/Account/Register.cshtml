@model RegisterViewModel
@{
    ViewData["Title"] = "Registrace";
    var registerErrors = ViewData.ModelState[string.Empty]?.Errors;
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-4 text-center">Registrace</h1>

                @if (registerErrors is { Count: > 0 })
                {
                    <div class="alert alert-danger" role="alert">
                        @foreach (var error in registerErrors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                    <div class="row g-2">
                        <div class="col-sm-6">
                            <div class="form-floating mb-3">
                                <input asp-for="FirstName" class="form-control" placeholder="Jméno" autocomplete="given-name" />
                                <label asp-for="FirstName"></label>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-floating mb-3">
                                <input asp-for="LastName" class="form-control" placeholder="Příjmení" autocomplete="family-name" />
                                <label asp-for="LastName"></label>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" />
                        <label asp-for="Email"></label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="DateOfBirth" class="form-control" placeholder="Datum narození" autocomplete="bday" />
                        <label asp-for="DateOfBirth"></label>
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" placeholder="Heslo" autocomplete="new-password" />
                        <label asp-for="Password"></label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Heslo znovu" autocomplete="new-password" />
                        <label asp-for="ConfirmPassword"></label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">Zaregistrovat se</button>
                </form>

                <hr class="my-4" />

                <p class="text-center text-muted mb-2">Už máte účet?</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary w-100">Přihlásit se</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
